<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="l君のpdf转换 · 测试组件">
        <!-- Synthetic fixtures, packaged exclusively in the instrumentation APK. -->
        <provider
            android:name="cn.local.imagepdf.platform.FolderTestDocumentsProvider"
            android:authorities="${applicationId}.folder-test-docs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider
            android:name="cn.local.imagepdf.platform.FolderTestGrantProvider"
            android:authorities="${applicationId}.folder-test-grants"
            android:exported="true" />
    </application>
</manifest>
